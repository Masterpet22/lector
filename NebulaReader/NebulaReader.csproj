<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Exclusivamente Android y Windows para agilizar compilaciones -->
		<TargetFrameworks Condition="'$(TargetFrameworks)' == '' and $([MSBuild]::IsOSPlatform('windows'))">net10.0-android;net10.0-windows10.0.19041.0</TargetFrameworks>
		<TargetFrameworks Condition="'$(TargetFrameworks)' == ''">net10.0-android</TargetFrameworks>

		<OutputType>Exe</OutputType>
		<DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
		<DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
		<RootNamespace>NebulaReader</RootNamespace>
		<UseMaui>true</UseMaui>
		<MauiEnableXamlCBindingWithSourceCompilation>true</MauiEnableXamlCBindingWithSourceCompilation>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<LangVersion>preview</LangVersion>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>

		<!-- Display name -->
		<ApplicationTitle>Nebula Reader</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>app.nebulareader.mobile</ApplicationId>

		<!-- Versions -->
		<ApplicationDisplayVersion>2.1.0</ApplicationDisplayVersion>
		<ApplicationVersion>5</ApplicationVersion>

		<!-- To develop, package, and publish an app to the Microsoft Store, see: https://aka.ms/MauiTemplateUnpackaged -->
		<WindowsPackageType>None</WindowsPackageType>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>

		<!-- Trimming, R8 y símbolos de depuración nativos en Release para Android -->
		<PublishTrimmed Condition="'$(Configuration)' == 'Release' and $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">true</PublishTrimmed>
		<AndroidLinkTool Condition="'$(Configuration)' == 'Release' and $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">r8</AndroidLinkTool>
		<UseDefaultPublishRuntimeIdentifier Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">false</UseDefaultPublishRuntimeIdentifier>
		<RuntimeIdentifiers Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">android-arm64;android-arm;android-x86;android-x64</RuntimeIdentifiers>
		<!-- Una APK Debug instalada directamente debe contener sus ensamblados. -->
		<EmbedAssembliesIntoApk Condition="'$(Configuration)' == 'Debug' and $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">true</EmbedAssembliesIntoApk>
	</PropertyGroup>

	<Target Name="_EmbedAndroidNativeDebugSymbols" AfterTargets="_BuildLibraryImportsCache;_PrepareBuildApk" BeforeTargets="_BuildApkEmbed" Condition="'$(Configuration)' == 'Release' and $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' and '$(AndroidPackageFormat)' == 'aab'">
		<ItemGroup>
			<AndroidAppBundleMetaDataFile Condition="Exists('$(IntermediateOutputPath)app_shared_libraries\arm64-v8a\libxamarin-app.dbg.so')" Include="com.android.tools.build.debugsymbols/arm64-v8a/libxamarin-app.so.sym:$(IntermediateOutputPath)app_shared_libraries\arm64-v8a\libxamarin-app.dbg.so" />
			<AndroidAppBundleMetaDataFile Condition="Exists('$(IntermediateOutputPath)app_shared_libraries\armeabi-v7a\libxamarin-app.dbg.so')" Include="com.android.tools.build.debugsymbols/armeabi-v7a/libxamarin-app.so.sym:$(IntermediateOutputPath)app_shared_libraries\armeabi-v7a\libxamarin-app.dbg.so" />
			<AndroidAppBundleMetaDataFile Condition="Exists('$(IntermediateOutputPath)app_shared_libraries\x86\libxamarin-app.dbg.so')" Include="com.android.tools.build.debugsymbols/x86/libxamarin-app.so.sym:$(IntermediateOutputPath)app_shared_libraries\x86\libxamarin-app.dbg.so" />
			<AndroidAppBundleMetaDataFile Condition="Exists('$(IntermediateOutputPath)app_shared_libraries\x86_64\libxamarin-app.dbg.so')" Include="com.android.tools.build.debugsymbols/x86_64/libxamarin-app.so.sym:$(IntermediateOutputPath)app_shared_libraries\x86_64\libxamarin-app.dbg.so" />
		</ItemGroup>
	</Target>

	<ItemGroup>
		<PackageReference Include="LanguageDetection.Ai" Version="1.1.0" />
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.png" Color="#08070E" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\nebula_reader_splash.png" Color="#08070E" BaseSize="256,256" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />
		<MauiImage Update="Resources\Images\dotnet_bot.png" Resize="True" BaseSize="300,185" />

		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="10.0.110" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
		<PackageReference Include="SharpCompress" Version="0.50.9" />
		<PackageReference Include="SkiaSharp" Version="4.156.0" />
		<PackageReference Include="SkiaSharp.Views.Maui.Controls" Version="4.156.0" />
		<PackageReference Include="sqlite-net-pcl" Version="1.11.285" />
	</ItemGroup>

</Project>
