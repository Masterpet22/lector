<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Note: For Android please see also Platforms\Android\Resources\values\colors.xml -->

    <!-- Paleta oscura moderna con acento morado neón -->
    <Color x:Key="BgCanvas">#08070E</Color>
    <Color x:Key="Surface1">#12101E</Color>
    <Color x:Key="Surface2">#1C1830</Color>
    <Color x:Key="Surface3">#272142</Color>
    <Color x:Key="HudOverlay">#E60D0B18</Color>

    <Color x:Key="NeonPurple">#B026FF</Color>
    <Color x:Key="NeonPurpleBright">#D884FF</Color>
    <Color x:Key="NeonPurpleDeep">#7C3AED</Color>
    <Color x:Key="NeonPurpleGlow">#4CB026FF</Color>

    <Color x:Key="SubtleBorder">#2A2346</Color>
    <Color x:Key="NeonBorder">#9D4EDD</Color>

    <Color x:Key="TextPrimary">#F5F3FF</Color>
    <Color x:Key="TextSecondary">#A99FC8</Color>
    <Color x:Key="TextMuted">#766B99</Color>

    <!-- Tokens base MAUI alineados al tema oscuro neón -->
    <Color x:Key="Primary">#B026FF</Color>
    <Color x:Key="PrimaryDark">#B026FF</Color>
    <Color x:Key="PrimaryDarkText">#FFFFFF</Color>
    <Color x:Key="Secondary">#241C3D</Color>
    <Color x:Key="SecondaryDarkText">#D884FF</Color>
    <Color x:Key="Tertiary">#7C3AED</Color>

    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#08070E</Color>
    <Color x:Key="Magenta">#B026FF</Color>
    <Color x:Key="MidnightBlue">#12101E</Color>
    <Color x:Key="OffBlack">#08070E</Color>

    <Color x:Key="Gray100">#E9E4FA</Color>
    <Color x:Key="Gray200">#C8BFE6</Color>
    <Color x:Key="Gray300">#9F94C4</Color>
    <Color x:Key="Gray400">#7E73A3</Color>
    <Color x:Key="Gray500">#5E5480</Color>
    <Color x:Key="Gray600">#3B3359</Color>
    <Color x:Key="Gray900">#171329</Color>
    <Color x:Key="Gray950">#0E0C1A</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>
    <SolidColorBrush x:Key="NeonPurpleBrush" Color="{StaticResource NeonPurple}"/>

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>
</ResourceDictionary>
