<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:NebulaReader.ViewModels"
             x:Class="NebulaReader.Views.ReaderPage"
             x:DataType="vm:ReaderViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource BgCanvas}"
             Title="{Binding Title}">

    <Grid BackgroundColor="{StaticResource BgCanvas}">
        <!-- Contenedor del lienzo SkiaSharp (SKGLView en Android / SKCanvasView en Windows) -->
        <ContentView x:Name="CanvasHost" />

        <ActivityIndicator IsRunning="{Binding IsBusy}"
                           IsVisible="{Binding IsBusy}"
                           Color="{StaticResource NeonPurpleBright}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           InputTransparent="True" />

        <!-- Barra superior translúcida (HUD) -->
        <Border x:Name="TopHudBar"
                VerticalOptions="Start"
                Margin="10,10,10,0"
                BackgroundColor="{StaticResource HudOverlay}"
                Stroke="{StaticResource SubtleBorder}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 20"
                Padding="14,12"
                IsVisible="{Binding IsHudVisible}">
            <Grid x:Name="TopHudGrid"
                  ColumnSpacing="8"
                  RowSpacing="6"
                  RowDefinitions="Auto,Auto,Auto"
                  ColumnDefinitions="Auto,*,Auto,Auto">
                <Button Grid.Column="0"
                        Text="← Volver"
                        Style="{StaticResource HudButton}"
                        Command="{Binding CloseReaderCommand}" />

                <Label x:Name="ReaderTitleLabel" Grid.Column="1"
                       Text="{Binding Title}"
                       TextColor="{StaticResource TextPrimary}"
                       FontFamily="OpenSansSemibold"
                       FontAttributes="Bold"
                       FontSize="15"
                       MaxLines="1"
                       LineBreakMode="TailTruncation"
                       VerticalTextAlignment="Center"
                       HorizontalTextAlignment="Center" />

                <Button x:Name="GoToPageButton" Grid.Column="2"
                        Text="Ir a página"
                        SemanticProperties.Description="Ir a página: marcadores y miniaturas"
                        Style="{StaticResource HudButton}"
                        Command="{Binding ShowBookmarksCommand}" />
                <Button x:Name="ReadingOptionsButton" Grid.Column="3"
                        Text="Opciones de lectura"
                        SemanticProperties.Description="Opciones de lectura"
                        Style="{StaticResource HudButton}"
                        Command="{Binding ShowReadingOptionsCommand}" />
            </Grid>
        </Border>

        <!-- Barra inferior translúcida (HUD) -->
        <Border x:Name="BottomHudBar"
                VerticalOptions="End"
                Margin="10,0,10,10"
                BackgroundColor="{StaticResource HudOverlay}"
                Stroke="{StaticResource SubtleBorder}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 20"
                Padding="16,10,16,12"
                IsVisible="{Binding IsHudVisible}">
            <VerticalStackLayout x:Name="BottomHudStack" Spacing="4">
                <Slider x:Name="PageSlider"
                        Minimum="1"
                        Maximum="{Binding SliderMaximum}"
                        IsEnabled="{Binding CanScrubPages}"
                        MinimumTrackColor="{StaticResource NeonPurple}"
                        MaximumTrackColor="{StaticResource Surface3}"
                        ThumbColor="{StaticResource NeonPurpleBright}"
                        DragStarted="OnPageSliderDragStarted"
                        ValueChanged="OnPageSliderValueChanged"
                        DragCompleted="OnPageSliderDragCompleted" />

                <Grid x:Name="BottomNavigationGrid" ColumnDefinitions="Auto,*,Auto"
                      RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="0">
                    <Button x:Name="PreviousPageButton" Grid.Column="0"
                            Text="{Binding PreviousVisualLabel}"
                            Style="{StaticResource HudButton}"
                            Command="{Binding GoPreviousVisualCommand}" />

                    <Label x:Name="PageIndicatorLabel" Grid.Column="1"
                           Text="{Binding PageIndicator}"
                           TextColor="{StaticResource TextPrimary}"
                           FontFamily="OpenSansSemibold"
                           FontAttributes="Bold"
                           FontSize="13"
                           MaxLines="1"
                           LineBreakMode="TailTruncation"
                           HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center" />

                    <Button x:Name="NextPageButton" Grid.Column="2"
                            Text="{Binding NextVisualLabel}"
                            Style="{StaticResource HudButton}"
                            Command="{Binding GoNextVisualCommand}" />
                </Grid>
                <Button Text="{Binding BookmarkButtonLabel}"
                        Style="{StaticResource HudButton}"
                        Command="{Binding ToggleCurrentPageBookmarkCommand}"
                        HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Border>

        <Border x:Name="ReadingOptionsPanel"
                IsVisible="{Binding IsReadingOptionsVisible}"
                HorizontalOptions="End" VerticalOptions="Fill"
                WidthRequest="340" Margin="0,8,8,8" Padding="16,16,4,16"
                BackgroundColor="{StaticResource BgCanvas}"
                Stroke="{StaticResource SubtleBorder}"
                StrokeShape="RoundRectangle 16">
            <ScrollView>
                <VerticalStackLayout Spacing="12" Padding="0,0,12,0">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Opciones de lectura" FontAttributes="Bold" FontSize="18"
                               TextColor="{StaticResource TextPrimary}" VerticalTextAlignment="Center" />
                        <Button Grid.Column="1" Text="Cerrar" Style="{StaticResource HudButton}"
                                Command="{Binding CloseReadingOptionsCommand}" />
                    </Grid>
                    <Label Text="{Binding PreferencesScopeLabel}"
                           TextColor="{StaticResource NeonPurpleBright}" FontAttributes="Bold" />
                    <Label Text="Los cambios se guardan para este libro. Restablecer aplica los valores generales de Configuración."
                           TextColor="{StaticResource TextSecondary}" />
                    <Button Text="{Binding LayoutModeLabel}" Style="{StaticResource HudButton}"
                            IsEnabled="{Binding IsBookPreferencesReady}"
                            Command="{Binding CycleLayoutModeCommand}" />
                    <Button Text="{Binding FitModeLabel}" Style="{StaticResource HudButton}"
                            IsEnabled="{Binding IsBookPreferencesReady}"
                            Command="{Binding CyclePageFitModeCommand}" />
                    <Button Text="{Binding DirectionModeLabel}" Style="{StaticResource HudButton}"
                            IsEnabled="{Binding IsBookPreferencesReady}"
                            Command="{Binding ToggleReadingDirectionCommand}" />
                    <Button Text="{Binding FilterModeLabel}" Style="{StaticResource HudButton}"
                            IsEnabled="{Binding IsBookPreferencesReady}"
                            Command="{Binding CycleVisualFilterCommand}" />
                    <Button Text="{Binding RotationLockLabel}" Style="{StaticResource HudButton}"
                            Command="{Binding ToggleRotationLockCommand}" />
                    <Button Text="{Binding FullScreenButtonLabel}" Style="{StaticResource HudButton}"
                            Command="{Binding ToggleFullScreenCommand}" />
                    <Button Text="Bloquear lectura" Style="{StaticResource HudButton}"
                            SemanticProperties.Description="Bloquear lectura y ocultar controles"
                            Command="{Binding LockReadingCommand}" />
                    <Button Text="Restablecer ajustes de este libro" Style="{StaticResource HudButton}"
                            IsEnabled="{Binding HasBookPreferences}"
                            Command="{Binding ResetBookPreferencesCommand}" />
                </VerticalStackLayout>
            </ScrollView>
        </Border>

        <Grid x:Name="BookmarksPanel" IsVisible="{Binding IsNavigationOverlayVisible}"
              BackgroundColor="{StaticResource BgCanvas}"
               RowDefinitions="Auto,Auto,*"
              Padding="14,12">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="0,0,0,12">
                <Button Text="← Volver" Style="{StaticResource HudButton}"
                        Command="{Binding CloseNavigationOverlayCommand}" />
                <Label Grid.Column="1" Text="Ir a página"
                       TextColor="{StaticResource TextPrimary}"
                       FontAttributes="Bold" VerticalTextAlignment="Center" />
            </Grid>
            <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="8" Margin="0,0,0,12">
                <Button Text="Marcadores" Style="{StaticResource HudButton}"
                        Command="{Binding ShowBookmarksCommand}" />
                <Button Grid.Column="1" Text="Miniaturas" Style="{StaticResource HudButton}"
                        Clicked="OnShowThumbnailsClicked" />
            </Grid>

            <CollectionView x:Name="BookmarksView" Grid.Row="2"
                            IsVisible="{Binding IsBookmarkListVisible}"
                            ItemsSource="{Binding BookmarkPages}"
                            SelectionMode="Single"
                            SelectionChanged="OnBookmarkSelected"
                            EmptyView="Este documento no tiene páginas marcadas.">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:PageNavigationItem">
                        <Border BackgroundColor="{StaticResource Surface3}"
                                Stroke="{StaticResource SubtleBorder}"
                                StrokeShape="RoundRectangle 12"
                                Padding="14,10" Margin="0,0,14,6">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="{Binding PageNumber, StringFormat='Página {0}'}"
                                       TextColor="{StaticResource TextPrimary}" VerticalTextAlignment="Center" />
                                <Label Grid.Column="1" Text="Actual"
                                       IsVisible="{Binding IsCurrent}"
                                       TextColor="{StaticResource NeonPurpleBright}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <CollectionView x:Name="ThumbnailsView" Grid.Row="2"
                            IsVisible="{Binding IsThumbnailGridVisible}"
                            ItemsSource="{Binding ThumbnailPages}"
                            SelectionMode="Single"
                            SelectionChanged="OnThumbnailSelected">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout x:Name="ThumbnailGridLayout" Orientation="Vertical" Span="3"
                                     VerticalItemSpacing="8" HorizontalItemSpacing="8" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:PageNavigationItem">
                        <Border BackgroundColor="{StaticResource Surface3}"
                                Stroke="{StaticResource SubtleBorder}"
                                StrokeShape="RoundRectangle 10"
                                Padding="5">
                            <VerticalStackLayout Spacing="4">
                                <Image Source="{Binding ThumbnailSource}" HeightRequest="110"
                                       Aspect="AspectFit" />
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4">
                                    <Label Text="{Binding PageNumber}"
                                           TextColor="{StaticResource TextPrimary}" FontSize="12" />
                                    <Label Grid.Column="1" Text="●" IsVisible="{Binding IsCurrent}"
                                           TextColor="{StaticResource NeonPurpleBright}" FontSize="12" />
                                    <Label Grid.Column="2" Text="★" IsVisible="{Binding IsBookmarked}"
                                           TextColor="{StaticResource NeonPurpleBright}" FontSize="12" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <!-- Captura los gestos mientras la lectura está bloqueada. -->
        <Grid IsVisible="{Binding IsReadingLocked}" BackgroundColor="Transparent">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnLockedPageTapped" />
            </Grid.GestureRecognizers>
            <Button x:Name="UnlockButton" IsVisible="{Binding IsUnlockButtonVisible}"
                    ImageSource="lock_closed.png"
                    BackgroundColor="{StaticResource HudOverlay}"
                    BorderColor="{StaticResource SubtleBorder}"
                    BorderWidth="1"
                    CornerRadius="28"
                    WidthRequest="72" HeightRequest="72"
                    Padding="16"
                    Margin="0,0,20,20"
                    HorizontalOptions="End" VerticalOptions="End"
                    SemanticProperties.Description="Desbloquear lectura"
                    Clicked="OnUnlockButtonClicked" />
        </Grid>
    </Grid>
</ContentPage>
