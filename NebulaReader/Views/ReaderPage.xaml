<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:NebulaReader.ViewModels"
             x:Class="NebulaReader.Views.ReaderPage"
             x:DataType="vm:ReaderViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource BgCanvas}"
             Title="{Binding Title}">

    <Grid BackgroundColor="{StaticResource BgCanvas}">
        <!-- Contenedor del lienzo SkiaSharp (SKGLView en Android / SKCanvasView en Windows) -->
        <ContentView x:Name="CanvasHost" />

        <ActivityIndicator IsRunning="{Binding IsBusy}"
                           IsVisible="{Binding IsBusy}"
                           Color="{StaticResource NeonPurpleBright}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           InputTransparent="True" />

        <!-- Barra superior translúcida (HUD) -->
        <Border x:Name="TopHudBar"
                VerticalOptions="Start"
                Margin="10,10,10,0"
                BackgroundColor="{StaticResource HudOverlay}"
                Stroke="{StaticResource SubtleBorder}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 20"
                Padding="14,12"
                IsVisible="{Binding IsHudVisible}">
            <Grid x:Name="TopHudGrid"
                  ColumnSpacing="8"
                  RowSpacing="6"
                  RowDefinitions="Auto,Auto"
                  ColumnDefinitions="Auto,*,Auto">
                <Button Grid.Row="0"
                        Grid.Column="0"
                        Text="← Volver"
                        Style="{StaticResource HudButton}"
                        Command="{Binding CloseReaderCommand}" />

                <Label Grid.Row="0"
                       Grid.Column="1"
                       Text="{Binding Title}"
                       TextColor="{StaticResource TextPrimary}"
                       FontFamily="OpenSansSemibold"
                       FontAttributes="Bold"
                       FontSize="15"
                       MaxLines="1"
                       LineBreakMode="TailTruncation"
                       VerticalTextAlignment="Center"
                       HorizontalTextAlignment="Center" />

                <Button Grid.Row="0"
                        Grid.Column="2"
                        Text="{Binding RotationLockLabel}"
                        Style="{StaticResource HudButton}"
                        Command="{Binding ToggleRotationLockCommand}" />

                <ScrollView x:Name="TopButtonsScroll"
                            Grid.Row="1"
                            Grid.ColumnSpan="3"
                            Orientation="Horizontal"
                            VerticalScrollBarVisibility="Never"
                            HorizontalScrollBarVisibility="Never">
                    <HorizontalStackLayout Spacing="8">
                        <Border Style="{StaticResource ReaderIconChip}"
                                SemanticProperties.Description="{Binding LayoutModeLabel}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding CycleLayoutModeCommand}" />
                            </Border.GestureRecognizers>
                            <HorizontalStackLayout Spacing="8">
                                <Image Source="{Binding LayoutModeIcon}"
                                       WidthRequest="20" HeightRequest="20"
                                       Aspect="AspectFit" VerticalOptions="Center" />
                                <Label Text="{Binding LayoutModeLabel}"
                                       FontFamily="OpenSansSemibold" FontSize="12"
                                       LineBreakMode="NoWrap" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>
                        <Button Text="{Binding FitModeLabel}"
                                Style="{StaticResource HudButton}"
                                Command="{Binding CyclePageFitModeCommand}" />
                        <Button Text="{Binding FullScreenButtonLabel}"
                                Style="{StaticResource HudButton}"
                                Command="{Binding ToggleFullScreenCommand}" />
                        <Border Style="{StaticResource ReaderIconChip}"
                                SemanticProperties.Description="{Binding DirectionModeLabel}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ToggleReadingDirectionCommand}" />
                            </Border.GestureRecognizers>
                            <HorizontalStackLayout Spacing="8">
                                <Image Source="{Binding ReadingDirectionIcon}"
                                       WidthRequest="20" HeightRequest="20"
                                       Aspect="AspectFit" VerticalOptions="Center" />
                                <Label Text="{Binding DirectionModeLabel}"
                                       FontFamily="OpenSansSemibold" FontSize="12"
                                       LineBreakMode="NoWrap" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>
                        <Button Text="{Binding FilterModeLabel}"
                                Style="{StaticResource HudButton}"
                                Command="{Binding CycleVisualFilterCommand}" />
                    </HorizontalStackLayout>
                </ScrollView>
            </Grid>
        </Border>

        <!-- Barra inferior translúcida (HUD) -->
        <Border x:Name="BottomHudBar"
                VerticalOptions="End"
                Margin="10,0,10,10"
                BackgroundColor="{StaticResource HudOverlay}"
                Stroke="{StaticResource SubtleBorder}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 20"
                Padding="16,10,16,12"
                IsVisible="{Binding IsHudVisible}">
            <VerticalStackLayout x:Name="BottomHudStack" Spacing="4">
                <Slider x:Name="PageSlider"
                        Minimum="1"
                        Maximum="{Binding SliderMaximum}"
                        IsEnabled="{Binding CanScrubPages}"
                        MinimumTrackColor="{StaticResource NeonPurple}"
                        MaximumTrackColor="{StaticResource Surface3}"
                        ThumbColor="{StaticResource NeonPurpleBright}"
                        DragStarted="OnPageSliderDragStarted"
                        ValueChanged="OnPageSliderValueChanged"
                        DragCompleted="OnPageSliderDragCompleted" />

                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                    <Button Grid.Column="0"
                            Text="Anterior"
                            Style="{StaticResource HudButton}"
                            Command="{Binding GoPreviousVisualCommand}" />

                    <Label Grid.Column="1"
                           Text="{Binding PageIndicator}"
                           TextColor="{StaticResource TextPrimary}"
                           FontFamily="OpenSansSemibold"
                           FontAttributes="Bold"
                           FontSize="13"
                           MaxLines="1"
                           LineBreakMode="TailTruncation"
                           HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center" />

                    <Button Grid.Column="2"
                            Text="Siguiente"
                            Style="{StaticResource HudButton}"
                            Command="{Binding GoNextVisualCommand}" />
                </Grid>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
