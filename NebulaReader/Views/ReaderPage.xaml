<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:NebulaReader.ViewModels"
             x:Class="NebulaReader.Views.ReaderPage"
             x:DataType="vm:ReaderViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource BgCanvas}"
             Title="{Binding Title}">

    <Grid BackgroundColor="{StaticResource BgCanvas}">
        <!-- Contenedor del lienzo SkiaSharp (SKGLView en Android / SKCanvasView en Windows) -->
        <ContentView x:Name="CanvasHost" />

        <ActivityIndicator IsRunning="{Binding IsBusy}"
                           IsVisible="{Binding IsBusy}"
                           Color="{StaticResource NeonPurpleBright}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           InputTransparent="True" />

        <!-- Barra superior translúcida (HUD) -->
        <Border x:Name="TopHudBar"
                VerticalOptions="Start"
                Margin="10,10,10,0"
                BackgroundColor="{StaticResource HudOverlay}"
                Stroke="{StaticResource NeonPurpleDeep}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 14"
                Padding="12,10"
                IsVisible="{Binding IsHudVisible}">
            <Grid x:Name="TopHudGrid"
                  ColumnSpacing="8"
                  RowSpacing="6"
                  RowDefinitions="Auto,Auto"
                  ColumnDefinitions="Auto,*,Auto">
                <Button Grid.Row="0"
                        Grid.Column="0"
                        Text="← Volver"
                        Style="{StaticResource HudButton}"
                        Command="{Binding CloseReaderCommand}" />

                <Label Grid.Row="0"
                       Grid.Column="1"
                       Text="{Binding Title}"
                       TextColor="{StaticResource TextPrimary}"
                       FontFamily="OpenSansSemibold"
                       FontAttributes="Bold"
                       FontSize="14"
                       MaxLines="1"
                       LineBreakMode="TailTruncation"
                       VerticalTextAlignment="Center"
                       HorizontalTextAlignment="Center" />

                <Button Grid.Row="0"
                        Grid.Column="2"
                        Text="{Binding RotationLockLabel}"
                        Style="{StaticResource HudButton}"
                        Command="{Binding ToggleRotationLockCommand}" />

                <ScrollView x:Name="TopButtonsScroll"
                            Grid.Row="1"
                            Grid.ColumnSpan="3"
                            Orientation="Vertical"
                            VerticalScrollBarVisibility="Never"
                            HorizontalScrollBarVisibility="Never">
                    <FlexLayout Wrap="Wrap"
                                JustifyContent="Center"
                                AlignItems="Center">
                        <Button Text="{Binding LayoutModeLabel}"
                                Style="{StaticResource HudButton}"
                                Margin="3"
                                Command="{Binding CycleLayoutModeCommand}" />
                        <Button Text="{Binding FitModeLabel}"
                                Style="{StaticResource HudButton}"
                                Margin="3"
                                Command="{Binding CyclePageFitModeCommand}" />
                        <Button Text="{Binding FullScreenButtonLabel}"
                                Style="{StaticResource HudButton}"
                                Margin="3"
                                Command="{Binding ToggleFullScreenCommand}" />
                        <Button Text="{Binding DirectionModeLabel}"
                                Style="{StaticResource HudButton}"
                                Margin="3"
                                Command="{Binding ToggleReadingDirectionCommand}" />
                        <Button Text="{Binding FilterModeLabel}"
                                Style="{StaticResource HudButton}"
                                Margin="3"
                                Command="{Binding CycleVisualFilterCommand}" />
                    </FlexLayout>
                </ScrollView>
            </Grid>
        </Border>

        <!-- Barra inferior translúcida (HUD) -->
        <Border x:Name="BottomHudBar"
                VerticalOptions="End"
                Margin="10,0,10,10"
                BackgroundColor="{StaticResource HudOverlay}"
                Stroke="{StaticResource NeonPurpleDeep}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 14"
                Padding="14,8,14,10"
                IsVisible="{Binding IsHudVisible}">
            <VerticalStackLayout x:Name="BottomHudStack" Spacing="4">
                <Slider x:Name="PageSlider"
                        Minimum="1"
                        Maximum="{Binding SliderMaximum}"
                        IsEnabled="{Binding CanScrubPages}"
                        MinimumTrackColor="{StaticResource NeonPurple}"
                        MaximumTrackColor="{StaticResource Surface3}"
                        ThumbColor="{StaticResource NeonPurpleBright}"
                        DragStarted="OnPageSliderDragStarted"
                        ValueChanged="OnPageSliderValueChanged"
                        DragCompleted="OnPageSliderDragCompleted" />

                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                    <Button Grid.Column="0"
                            Text="Anterior"
                            Style="{StaticResource HudButton}"
                            Command="{Binding GoPreviousVisualCommand}" />

                    <Label Grid.Column="1"
                           Text="{Binding PageIndicator}"
                           TextColor="{StaticResource TextPrimary}"
                           FontFamily="OpenSansSemibold"
                           FontAttributes="Bold"
                           FontSize="13"
                           MaxLines="1"
                           LineBreakMode="TailTruncation"
                           HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center" />

                    <Button Grid.Column="2"
                            Text="Siguiente"
                            Style="{StaticResource HudButton}"
                            Command="{Binding GoNextVisualCommand}" />
                </Grid>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
