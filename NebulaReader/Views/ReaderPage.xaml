<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:NebulaReader.ViewModels"
             x:Class="NebulaReader.Views.ReaderPage"
             x:DataType="vm:ReaderViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource BgCanvas}"
             Title="{Binding Title}">

    <Grid BackgroundColor="{StaticResource BgCanvas}">
        <!-- Contenedor del lienzo SkiaSharp (SKGLView en Android / SKCanvasView en Windows) -->
        <ContentView x:Name="CanvasHost" />

        <ActivityIndicator IsRunning="{Binding IsBusy}"
                           IsVisible="{Binding IsBusy}"
                           Color="{StaticResource NeonPurpleBright}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           InputTransparent="True" />

        <!-- Barra superior translúcida (HUD) -->
        <Border x:Name="TopHudBar"
                VerticalOptions="Start"
                Margin="10,10,10,0"
                BackgroundColor="{StaticResource HudOverlay}"
                Stroke="{StaticResource SubtleBorder}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 20"
                Padding="14,12"
                IsVisible="{Binding IsHudVisible}">
            <Grid x:Name="TopHudGrid"
                  ColumnSpacing="8"
                  RowSpacing="6"
                  RowDefinitions="Auto,Auto"
                  ColumnDefinitions="Auto,*,Auto">
                <Button Grid.Row="0"
                        Grid.Column="0"
                        Text="← Volver"
                        Style="{StaticResource HudButton}"
                        Command="{Binding CloseReaderCommand}" />

                <Label Grid.Row="0"
                       Grid.Column="1"
                       Text="{Binding Title}"
                       TextColor="{StaticResource TextPrimary}"
                       FontFamily="OpenSansSemibold"
                       FontAttributes="Bold"
                       FontSize="15"
                       MaxLines="1"
                       LineBreakMode="TailTruncation"
                       VerticalTextAlignment="Center"
                       HorizontalTextAlignment="Center" />

                <Button Grid.Row="0"
                        Grid.Column="2"
                        Text="{Binding RotationLockLabel}"
                        Style="{StaticResource HudButton}"
                        Command="{Binding ToggleRotationLockCommand}" />

                <ScrollView x:Name="TopButtonsScroll"
                            Grid.Row="1"
                            Grid.ColumnSpan="3"
                            Orientation="Horizontal"
                            VerticalScrollBarVisibility="Never"
                            HorizontalScrollBarVisibility="Never">
                    <HorizontalStackLayout Spacing="8">
                        <Border Style="{StaticResource ReaderIconChip}"
                                IsEnabled="{Binding IsBookPreferencesReady}"
                                SemanticProperties.Description="{Binding LayoutModeLabel}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding CycleLayoutModeCommand}" />
                            </Border.GestureRecognizers>
                            <HorizontalStackLayout Spacing="8">
                                <Image Source="{Binding LayoutModeIcon}"
                                       WidthRequest="20" HeightRequest="20"
                                       Aspect="AspectFit" VerticalOptions="Center" />
                                <Label Text="{Binding LayoutModeLabel}"
                                       FontFamily="OpenSansSemibold" FontSize="12"
                                       LineBreakMode="NoWrap" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>
                        <Button Text="{Binding FitModeLabel}"
                                Style="{StaticResource HudButton}"
                                IsEnabled="{Binding IsBookPreferencesReady}"
                                Command="{Binding CyclePageFitModeCommand}" />
                        <Button Text="{Binding FullScreenButtonLabel}"
                                Style="{StaticResource HudButton}"
                                Command="{Binding ToggleFullScreenCommand}" />
                        <Border Style="{StaticResource ReaderIconChip}"
                                IsEnabled="{Binding IsBookPreferencesReady}"
                                SemanticProperties.Description="{Binding DirectionModeLabel}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ToggleReadingDirectionCommand}" />
                            </Border.GestureRecognizers>
                            <HorizontalStackLayout Spacing="8">
                                <Image Source="{Binding ReadingDirectionIcon}"
                                       WidthRequest="20" HeightRequest="20"
                                       Aspect="AspectFit" VerticalOptions="Center" />
                                <Label Text="{Binding DirectionModeLabel}"
                                       FontFamily="OpenSansSemibold" FontSize="12"
                                       LineBreakMode="NoWrap" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>
                        <Button Text="{Binding FilterModeLabel}"
                                Style="{StaticResource HudButton}"
                                IsEnabled="{Binding IsBookPreferencesReady}"
                                Command="{Binding CycleVisualFilterCommand}" />
                        <Label Text="{Binding PreferencesScopeLabel}"
                               TextColor="{StaticResource TextSecondary}"
                               FontSize="12" VerticalTextAlignment="Center" />
                        <Button Text="Restablecer ajustes"
                                Style="{StaticResource HudButton}"
                                IsEnabled="{Binding HasBookPreferences}"
                                Command="{Binding ResetBookPreferencesCommand}" />
                        <Button Text="{Binding BookmarkButtonLabel}"
                                Style="{StaticResource HudButton}"
                                Command="{Binding ToggleCurrentPageBookmarkCommand}" />
                        <Button Text="Marcadores"
                                Style="{StaticResource HudButton}"
                                Command="{Binding ShowBookmarksCommand}" />
                        <Button Text="Miniaturas"
                                Style="{StaticResource HudButton}"
                                Clicked="OnShowThumbnailsClicked" />
                    </HorizontalStackLayout>
                </ScrollView>
            </Grid>
        </Border>

        <!-- Barra inferior translúcida (HUD) -->
        <Border x:Name="BottomHudBar"
                VerticalOptions="End"
                Margin="10,0,10,10"
                BackgroundColor="{StaticResource HudOverlay}"
                Stroke="{StaticResource SubtleBorder}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 20"
                Padding="16,10,16,12"
                IsVisible="{Binding IsHudVisible}">
            <VerticalStackLayout x:Name="BottomHudStack" Spacing="4">
                <Slider x:Name="PageSlider"
                        Minimum="1"
                        Maximum="{Binding SliderMaximum}"
                        IsEnabled="{Binding CanScrubPages}"
                        MinimumTrackColor="{StaticResource NeonPurple}"
                        MaximumTrackColor="{StaticResource Surface3}"
                        ThumbColor="{StaticResource NeonPurpleBright}"
                        DragStarted="OnPageSliderDragStarted"
                        ValueChanged="OnPageSliderValueChanged"
                        DragCompleted="OnPageSliderDragCompleted" />

                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                    <Button Grid.Column="0"
                            Text="Anterior"
                            Style="{StaticResource HudButton}"
                            Command="{Binding GoPreviousVisualCommand}" />

                    <Label Grid.Column="1"
                           Text="{Binding PageIndicator}"
                           TextColor="{StaticResource TextPrimary}"
                           FontFamily="OpenSansSemibold"
                           FontAttributes="Bold"
                           FontSize="13"
                           MaxLines="1"
                           LineBreakMode="TailTruncation"
                           HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center" />

                    <Button Grid.Column="2"
                            Text="Siguiente"
                            Style="{StaticResource HudButton}"
                            Command="{Binding GoNextVisualCommand}" />
                </Grid>
            </VerticalStackLayout>
        </Border>

        <Grid IsVisible="{Binding IsNavigationOverlayVisible}"
              BackgroundColor="{StaticResource BgCanvas}"
              RowDefinitions="Auto,*"
              Padding="14,12">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="0,0,0,12">
                <Button Text="← Volver" Style="{StaticResource HudButton}"
                        Command="{Binding CloseNavigationOverlayCommand}" />
                <Label Grid.Column="1" Text="Navegación de páginas"
                       TextColor="{StaticResource TextPrimary}"
                       FontAttributes="Bold" VerticalTextAlignment="Center" />
            </Grid>

            <CollectionView x:Name="BookmarksView" Grid.Row="1"
                            IsVisible="{Binding IsBookmarkListVisible}"
                            ItemsSource="{Binding BookmarkPages}"
                            SelectionMode="Single"
                            SelectionChanged="OnBookmarkSelected"
                            EmptyView="Este documento no tiene páginas marcadas.">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:PageNavigationItem">
                        <Border BackgroundColor="{StaticResource Surface3}"
                                Stroke="{StaticResource SubtleBorder}"
                                StrokeShape="RoundRectangle 12"
                                Padding="14,10" Margin="0,0,0,6">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="{Binding PageNumber, StringFormat='Página {0}'}"
                                       TextColor="{StaticResource TextPrimary}" VerticalTextAlignment="Center" />
                                <Label Grid.Column="1" Text="Actual"
                                       IsVisible="{Binding IsCurrent}"
                                       TextColor="{StaticResource NeonPurpleBright}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <CollectionView x:Name="ThumbnailsView" Grid.Row="1"
                            IsVisible="{Binding IsThumbnailGridVisible}"
                            ItemsSource="{Binding ThumbnailPages}"
                            SelectionMode="Single"
                            SelectionChanged="OnThumbnailSelected">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="3"
                                     VerticalItemSpacing="8" HorizontalItemSpacing="8" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:PageNavigationItem">
                        <Border BackgroundColor="{StaticResource Surface3}"
                                Stroke="{StaticResource SubtleBorder}"
                                StrokeShape="RoundRectangle 10"
                                Padding="5">
                            <VerticalStackLayout Spacing="4">
                                <Image Source="{Binding ThumbnailSource}" HeightRequest="110"
                                       Aspect="AspectFit" />
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4">
                                    <Label Text="{Binding PageNumber}"
                                           TextColor="{StaticResource TextPrimary}" FontSize="12" />
                                    <Label Grid.Column="1" Text="●" IsVisible="{Binding IsCurrent}"
                                           TextColor="{StaticResource NeonPurpleBright}" FontSize="12" />
                                    <Label Grid.Column="2" Text="★" IsVisible="{Binding IsBookmarked}"
                                           TextColor="{StaticResource NeonPurpleBright}" FontSize="12" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
    </Grid>
</ContentPage>
