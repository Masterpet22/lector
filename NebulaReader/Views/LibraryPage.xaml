<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:NebulaReader.ViewModels"
             xmlns:models="clr-namespace:NebulaReader.Models"
             x:Class="NebulaReader.Views.LibraryPage"
             x:DataType="vm:LibraryViewModel"
             Title="{Binding Title}">

    <Grid RowDefinitions="Auto,*,Auto" Padding="16" RowSpacing="12">
        <HorizontalStackLayout Grid.Row="0" Spacing="10">
            <Button Text="Abrir Archivo"
                    Command="{Binding OpenFileCommand}" />
            <Button Text="Configuración"
                    Command="{Binding OpenSettingsCommand}" />
        </HorizontalStackLayout>

        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Books}"
                        SelectionMode="Single">
            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical" Span="2" HorizontalItemSpacing="10" VerticalItemSpacing="10" />
            </CollectionView.ItemsLayout>
            <CollectionView.EmptyView>
                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="8">
                    <Label Text="Tu biblioteca está vacía"
                           FontSize="18"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center" />
                    <Label Text="Pulsa 'Abrir Archivo' para importar un CBZ, CBR o PDF."
                           HorizontalTextAlignment="Center"
                           Opacity="0.7" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:BookItem">
                    <Border Padding="12" StrokeThickness="1">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:LibraryViewModel}}, Path=OpenBookCommand}"
                                                  CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding Title}" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                            <Label Text="{Binding Format}" FontSize="12" Opacity="0.7" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Label Grid.Row="2"
               Text="{Binding StatusMessage}"
               FontSize="12"
               Opacity="0.8" />
    </Grid>
</ContentPage>

