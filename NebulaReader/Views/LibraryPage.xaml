<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:NebulaReader.ViewModels"
             xmlns:models="clr-namespace:NebulaReader.Models"
             x:Class="NebulaReader.Views.LibraryPage"
             x:Name="LibraryRootPage"
             x:DataType="vm:LibraryViewModel"
             Shell.NavBarIsVisible="{Binding IsNotFullScreen}"
             BackgroundColor="{StaticResource BgCanvas}"
             Title="{Binding Title}">

    <Grid x:Name="LibraryRootGrid" RowDefinitions="Auto,Auto,Auto,*,Auto" Padding="18,16" RowSpacing="16">
        <Border x:Name="LibraryToolbarBorder"
                Grid.Row="0"
                BackgroundColor="{StaticResource Surface1}"
                Stroke="{StaticResource SubtleBorder}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 22"
                Padding="18,16">
            <VerticalStackLayout Spacing="16">
                <Grid ColumnDefinitions="48,*" ColumnSpacing="12">
                    <Image Grid.Column="0" Source="nebula_brand.png"
                           WidthRequest="48" HeightRequest="48"
                           Aspect="AspectFit" VerticalOptions="Center"
                           SemanticProperties.Description="Nebula Reader" />
                    <VerticalStackLayout Grid.Column="1" Spacing="3">
                        <Label Text="NEBULA READER" Style="{StaticResource EyebrowLabel}" />
                        <Label Text="Tu biblioteca" Style="{StaticResource SectionTitleLabel}" />
                        <Label Text="Tus historias, listas para continuar."
                               TextColor="{StaticResource TextSecondary}"
                               FontSize="12" />
                    </VerticalStackLayout>
                </Grid>
            <Grid x:Name="LibraryToolbarGrid"
                  ColumnDefinitions="*,*"
                  RowDefinitions="Auto,Auto,Auto"
                  ColumnSpacing="8"
                  RowSpacing="8">
                <Button x:Name="OpenFileButton"
                        Grid.Row="0"
                        Grid.Column="0"
                        Text="Abrir archivo"
                        Style="{StaticResource PrimaryNeonButton}"
                        Command="{Binding OpenFileCommand}" />
                <Button x:Name="ScanFolderButton"
                        Grid.Row="0"
                        Grid.Column="1"
                        Text="Escanear carpeta"
                        Command="{Binding ImportFolderCommand}" />
                <Button x:Name="SettingsButton"
                        Grid.Row="1"
                        Grid.Column="0"
                        Text="Configuración"
                        Command="{Binding OpenSettingsCommand}" />
                <Button x:Name="FullScreenButton"
                        Grid.Row="1"
                        Grid.Column="1"
                        Text="{Binding FullScreenButtonLabel}"
                        Command="{Binding ToggleFullScreenCommand}" />
                <ActivityIndicator x:Name="ToolbarBusyIndicator"
                                   Grid.Row="2"
                                   Grid.Column="0"
                                   Grid.ColumnSpan="2"
                                   IsRunning="{Binding IsBusy}"
                                   IsVisible="{Binding IsBusy}"
                                   Color="{StaticResource NeonPurpleBright}"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
            </Grid>
            </VerticalStackLayout>
        </Border>

        <!-- Barra de navegación dentro de una serie/saga -->
        <Border x:Name="LibraryBreadcrumbBorder"
                Grid.Row="1"
                IsVisible="{Binding IsInsideGroup}"
                BackgroundColor="{StaticResource Surface1}"
                Stroke="{StaticResource SubtleBorder}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 16"
                Padding="12,9">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <Button Grid.Column="0"
                        Text="← Biblioteca"
                        Style="{StaticResource HudButton}"
                        Command="{Binding ExitGroupCommand}" />
                <Label Grid.Column="1"
                       Text="{Binding ActiveGroupTitle}"
                       VerticalOptions="Center"
                       TextColor="{StaticResource TextPrimary}"
                       FontFamily="OpenSansSemibold"
                       FontSize="15"
                       FontAttributes="Bold"
                       LineBreakMode="TailTruncation" />
            </Grid>
        </Border>

        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="2,0">
            <Label Grid.Column="0" Text="COLECCIÓN" Style="{StaticResource EyebrowLabel}" VerticalOptions="Center" />
            <Label Grid.Column="1" Text="CBZ · CBR · PDF"
                   TextColor="{StaticResource TextMuted}"
                   FontSize="11" VerticalOptions="Center" />
        </Grid>

        <CollectionView Grid.Row="3"
                        ItemsSource="{Binding DisplayItems}"
                        SelectionMode="None">
            <CollectionView.ItemsLayout>
                <GridItemsLayout x:Name="LibraryGridLayout"
                                 Orientation="Vertical"
                                 Span="2"
                                 HorizontalItemSpacing="12"
                                 VerticalItemSpacing="12" />
            </CollectionView.ItemsLayout>

            <CollectionView.EmptyView>
                <ScrollView>
                    <Border VerticalOptions="Center"
                            HorizontalOptions="Center"
                            MaximumWidthRequest="440"
                            BackgroundColor="{StaticResource Surface1}"
                            Stroke="{StaticResource SubtleBorder}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 22"
                            Padding="28,24"
                            Margin="12">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="NEBULA READER"
                                   TextColor="{StaticResource NeonPurpleBright}"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="12"
                                   CharacterSpacing="2"
                                   HorizontalTextAlignment="Center" />
                            <Label Text="Tu biblioteca está vacía"
                                   TextColor="{StaticResource TextPrimary}"
                                   FontSize="19"
                                   FontAttributes="Bold"
                                   HorizontalTextAlignment="Center" />
                            <Label Text="Pulsa 'Abrir Archivo' o 'Escanear Carpeta' para importar cómics (.cbz, .cbr) o PDF."
                                   TextColor="{StaticResource TextSecondary}"
                                   HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>
                </ScrollView>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:LibraryDisplayItem">
                    <Border Padding="9"
                            BackgroundColor="{StaticResource Surface1}"
                            Stroke="{StaticResource SubtleBorder}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 20">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsGroup}" Value="True">
                                <Setter Property="Stroke" Value="{StaticResource NeonPurpleDeep}" />
                                <Setter Property="StrokeThickness" Value="1" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                x:DataType="{x:Null}"
                                Command="{Binding Source={x:Reference LibraryRootPage}, Path=BindingContext.OpenItemCommand}"
                                CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>

                        <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="6">
                            <Border Grid.Row="0"
                                    HeightRequest="{Binding CoverHeight}"
                                    BackgroundColor="{StaticResource BgCanvas}"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 14">
                                <Grid>
                                    <Label Text="{Binding BadgeText}"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"
                                           TextColor="{StaticResource TextMuted}"
                                           FontAttributes="Bold" />

                                    <!-- Portada individual -->
                                    <Image IsVisible="{Binding IsSingleBook}"
                                           Source="{Binding Cover1}"
                                           Aspect="AspectFill" />

                                    <!-- Mosaico 2x2 de las primeras 4 portadas del grupo -->
                                    <Grid IsVisible="{Binding IsGroup}"
                                          RowDefinitions="*,*"
                                          ColumnDefinitions="*,*"
                                          RowSpacing="2"
                                          ColumnSpacing="2"
                                          BackgroundColor="{StaticResource BgCanvas}">
                                        <Border Grid.Row="0" Grid.Column="0"
                                                BackgroundColor="{StaticResource Surface2}"
                                                StrokeThickness="0">
                                            <Image IsVisible="{Binding HasCover1}" Source="{Binding Cover1}" Aspect="AspectFill" />
                                        </Border>
                                        <Border Grid.Row="0" Grid.Column="1"
                                                BackgroundColor="{StaticResource Surface2}"
                                                StrokeThickness="0">
                                            <Image IsVisible="{Binding HasCover2}" Source="{Binding Cover2}" Aspect="AspectFill" />
                                        </Border>
                                        <Border Grid.Row="1" Grid.Column="0"
                                                BackgroundColor="{StaticResource Surface2}"
                                                StrokeThickness="0">
                                            <Image IsVisible="{Binding HasCover3}" Source="{Binding Cover3}" Aspect="AspectFill" />
                                        </Border>
                                        <Border Grid.Row="1" Grid.Column="1"
                                                BackgroundColor="{StaticResource Surface2}"
                                                StrokeThickness="0">
                                            <Image IsVisible="{Binding HasCover4}" Source="{Binding Cover4}" Aspect="AspectFill" />
                                        </Border>
                                    </Grid>

                                    <!-- Insignia superior derecha -->
                                    <Border HorizontalOptions="End"
                                            VerticalOptions="Start"
                                            Margin="6"
                                            Padding="7,3"
                                            StrokeThickness="1"
                                            Stroke="{StaticResource SubtleBorder}"
                                            StrokeShape="RoundRectangle 10"
                                            BackgroundColor="#D90E0B1A">
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsGroup}" Value="True">
                                                <Setter Property="BackgroundColor" Value="#D97C3AED" />
                                                <Setter Property="Stroke" Value="{StaticResource NeonPurpleBright}" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <Label Text="{Binding BadgeText}"
                                               TextColor="{StaticResource White}"
                                               FontFamily="OpenSansSemibold"
                                               FontSize="10"
                                               FontAttributes="Bold" />
                                    </Border>
                                </Grid>
                            </Border>

                            <Label Grid.Row="1"
                                   Text="{Binding Title}"
                                   TextColor="{StaticResource TextPrimary}"
                                   FontFamily="OpenSansSemibold"
                                   FontAttributes="Bold"
                                   FontSize="15"
                                   Margin="3,5,3,0"
                                   LineBreakMode="TailTruncation"
                                   MaxLines="2" />

                            <Label Grid.Row="2"
                                   Text="{Binding SubtitleText}"
                                   TextColor="{StaticResource TextSecondary}"
                                   FontSize="12"
                                   Margin="3,0"
                                   LineBreakMode="TailTruncation" />

                            <Label Grid.Row="3"
                                   IsVisible="{Binding HasTags}"
                                   Text="{Binding TagsText}"
                                   FontSize="11"
                                   Margin="3,0"
                                   TextColor="{StaticResource NeonPurpleBright}"
                                   LineBreakMode="TailTruncation" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Pie de estado -->
        <Border x:Name="LibraryFooterBorder"
                Grid.Row="4"
                BackgroundColor="{StaticResource Surface1}"
                Stroke="{StaticResource SubtleBorder}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 14"
                Padding="14,9">
            <Label Text="{Binding StatusMessage}"
                   TextColor="{StaticResource TextSecondary}"
                   FontSize="12"
                   LineBreakMode="TailTruncation" />
        </Border>
    </Grid>
</ContentPage>
