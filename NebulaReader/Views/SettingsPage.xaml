<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:NebulaReader.ViewModels"
             x:Class="NebulaReader.Views.SettingsPage"
             x:DataType="vm:SettingsViewModel"
             BackgroundColor="{StaticResource BgCanvas}"
             Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout x:Name="SettingsContainer"
                             Padding="20"
                             Spacing="18"
                             HorizontalOptions="Center">

            <VerticalStackLayout Spacing="4" Margin="2,4,2,8">
                <Label Text="PREFERENCIAS" Style="{StaticResource EyebrowLabel}" />
                <Label Text="Hazlo tuyo" Style="{StaticResource SectionTitleLabel}" FontSize="28" />
                <Label Text="Personaliza la lectura para cada historia."
                       TextColor="{StaticResource TextSecondary}"
                       FontSize="13" />
            </VerticalStackLayout>

            <!-- Sección: Apariencia y lectura -->
            <Border BackgroundColor="{StaticResource Surface1}"
                    Stroke="{StaticResource SubtleBorder}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 20"
                    Padding="20">
                <VerticalStackLayout Spacing="16">
                    <Label Text="APARIENCIA Y LECTURA"
                           TextColor="{StaticResource NeonPurpleBright}"
                           FontFamily="OpenSansSemibold"
                           FontSize="12"
                           CharacterSpacing="1.4" />

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" MinimumHeightRequest="48">
                        <Label Text="Modo lectura nocturna (inversión suave)"
                               TextColor="{StaticResource TextPrimary}"
                               LineBreakMode="WordWrap"
                               VerticalOptions="Center" />
                        <Switch Grid.Column="1" IsToggled="{Binding NightReadingModeEnabled}" />
                    </Grid>

                    <BoxView HeightRequest="1" BackgroundColor="{StaticResource SubtleBorder}" />

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" MinimumHeightRequest="48">
                        <Label Text="Filtro visual sepia"
                               TextColor="{StaticResource TextPrimary}"
                               LineBreakMode="WordWrap"
                               VerticalOptions="Center" />
                        <Switch Grid.Column="1" IsToggled="{Binding SepiaFilterEnabled}" />
                    </Grid>

                    <BoxView HeightRequest="1" BackgroundColor="{StaticResource SubtleBorder}" />

                    <Grid ColumnDefinitions="28,*,Auto" ColumnSpacing="12" MinimumHeightRequest="48">
                        <Image Grid.Column="0" Source="{Binding ReadingDirectionIcon}"
                               WidthRequest="24" HeightRequest="24"
                               Aspect="AspectFit" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="Lectura derecha a izquierda (Manga)"
                               TextColor="{StaticResource TextPrimary}"
                               LineBreakMode="WordWrap"
                               VerticalOptions="Center" />
                        <Switch Grid.Column="2" IsToggled="{Binding RightToLeftMangaMode}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Sección: Disposición y ajuste -->
            <Border BackgroundColor="{StaticResource Surface1}"
                    Stroke="{StaticResource SubtleBorder}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 20"
                    Padding="20">
                <VerticalStackLayout Spacing="18">
                    <Label Text="DISPOSICIÓN Y AJUSTE"
                           TextColor="{StaticResource NeonPurpleBright}"
                           FontFamily="OpenSansSemibold"
                           FontSize="12"
                           CharacterSpacing="1.4" />

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Modo de vista"
                               TextColor="{StaticResource TextSecondary}"
                               FontSize="13" />
                        <Border BackgroundColor="{StaticResource Surface2}"
                                Stroke="{StaticResource SubtleBorder}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 14"
                                Padding="12,3">
                            <Grid ColumnDefinitions="28,*" ColumnSpacing="10">
                                <Image Source="{Binding LayoutModeIcon}"
                                       WidthRequest="24" HeightRequest="24"
                                       Aspect="AspectFit" VerticalOptions="Center" />
                                <Picker Grid.Column="1"
                                        ItemsSource="{Binding LayoutModeOptions}"
                                        SelectedIndex="{Binding SelectedLayoutModeIndex}" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Ajuste de página"
                               TextColor="{StaticResource TextSecondary}"
                               FontSize="13" />
                        <Border BackgroundColor="{StaticResource Surface2}"
                                Stroke="{StaticResource SubtleBorder}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 14"
                                Padding="12,3">
                            <Picker ItemsSource="{Binding PageFitModeOptions}"
                                    SelectedIndex="{Binding SelectedPageFitModeIndex}" />
                        </Border>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Sección: Ventana -->
            <Border BackgroundColor="{StaticResource Surface1}"
                    Stroke="{StaticResource SubtleBorder}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 20"
                    Padding="20">
                <VerticalStackLayout Spacing="16">
                    <Label Text="VENTANA"
                           TextColor="{StaticResource NeonPurpleBright}"
                           FontFamily="OpenSansSemibold"
                           FontSize="12"
                           CharacterSpacing="1.4" />

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" MinimumHeightRequest="48">
                        <Label Text="Pantalla completa"
                               TextColor="{StaticResource TextPrimary}"
                               LineBreakMode="WordWrap"
                               VerticalOptions="Center" />
                        <Switch Grid.Column="1" IsToggled="{Binding IsFullScreen}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Button Text="Volver"
                    Style="{StaticResource PrimaryNeonButton}"
                    Command="{Binding GoBackCommand}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
