<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:NebulaReader.ViewModels"
             x:Class="NebulaReader.Views.SettingsPage"
             x:DataType="vm:SettingsViewModel"
             Title="{Binding Title}">

    <VerticalStackLayout Padding="20" Spacing="16">
        <Grid ColumnDefinitions="*,Auto">
            <Label Text="Modo lectura nocturna" VerticalOptions="Center" />
            <Switch Grid.Column="1" IsToggled="{Binding NightReadingModeEnabled}" />
        </Grid>

        <Grid ColumnDefinitions="*,Auto">
            <Label Text="Lectura derecha a izquierda (Manga)" VerticalOptions="Center" />
            <Switch Grid.Column="1" IsToggled="{Binding RightToLeftMangaMode}" />
        </Grid>

        <Grid ColumnDefinitions="*,Auto">
            <Label Text="Desplazamiento vertical continuo" VerticalOptions="Center" />
            <Switch Grid.Column="1" IsToggled="{Binding ContinuousVerticalScroll}" />
        </Grid>

        <Button Text="Volver" Command="{Binding GoBackCommand}" />
    </VerticalStackLayout>
</ContentPage>

