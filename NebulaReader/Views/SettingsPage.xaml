<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:NebulaReader.ViewModels"
             x:Class="NebulaReader.Views.SettingsPage"
             x:DataType="vm:SettingsViewModel"
             Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">
            <Grid ColumnDefinitions="*,Auto">
                <Label Text="Modo lectura nocturna (inversión suave)" VerticalOptions="Center" />
                <Switch Grid.Column="1" IsToggled="{Binding NightReadingModeEnabled}" />
            </Grid>

            <Grid ColumnDefinitions="*,Auto">
                <Label Text="Filtro visual sepia" VerticalOptions="Center" />
                <Switch Grid.Column="1" IsToggled="{Binding SepiaFilterEnabled}" />
            </Grid>

            <Grid ColumnDefinitions="*,Auto">
                <Label Text="Lectura derecha a izquierda (Manga)" VerticalOptions="Center" />
                <Switch Grid.Column="1" IsToggled="{Binding RightToLeftMangaMode}" />
            </Grid>

            <VerticalStackLayout Spacing="6">
                <Label Text="Modo de vista" FontAttributes="Bold" />
                <Picker ItemsSource="{Binding LayoutModeOptions}"
                        SelectedIndex="{Binding SelectedLayoutModeIndex}" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="6">
                <Label Text="Ajuste de página" FontAttributes="Bold" />
                <Picker ItemsSource="{Binding PageFitModeOptions}"
                        SelectedIndex="{Binding SelectedPageFitModeIndex}" />
            </VerticalStackLayout>

            <Grid ColumnDefinitions="*,Auto">
                <Label Text="Pantalla completa" VerticalOptions="Center" />
                <Switch Grid.Column="1" IsToggled="{Binding IsFullScreen}" />
            </Grid>

            <Button Text="Volver" Command="{Binding GoBackCommand}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
