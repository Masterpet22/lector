<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:NebulaReader.ViewModels"
             xmlns:models="clr-namespace:NebulaReader.Models"
             xmlns:views="clr-namespace:NebulaReader.Views"
             xmlns:services="clr-namespace:NebulaReader.Services"
             x:Class="NebulaReader.Views.SettingsPage"
             x:Name="SettingsRootPage"
             x:DataType="vm:SettingsViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource BgCanvas}"
             Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout x:Name="SettingsContainer"
                             Padding="20"
                             Spacing="18"
                             HorizontalOptions="Center">

            <VerticalStackLayout Spacing="4" Margin="2,4,2,8">
                <Label Text="PREFERENCIAS" Style="{StaticResource EyebrowLabel}" />
                <Label Text="Configuración" Style="{StaticResource SectionTitleLabel}" FontSize="26" />
                <Label Text="Valores generales para libros sin ajustes propios."
                       TextColor="{StaticResource TextSecondary}"
                       FontSize="13" LineBreakMode="WordWrap" />
            </VerticalStackLayout>

            <Border Style="{StaticResource SectionPanel}" StrokeShape="RoundRectangle 20" Padding="20"
                    IsVisible="{Binding CanRegisterFileAssociations}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="ABRIR DOCUMENTOS" TextColor="{StaticResource NeonPurpleBright}"
                           FontFamily="OpenSansSemibold" FontSize="12" CharacterSpacing="1.4" />
                    <Label Text="Ofrece Nebula Reader para abrir CBZ, CBR y PDF. Después elige los formatos en Aplicaciones predeterminadas de Windows."
                           TextColor="{StaticResource TextSecondary}" FontSize="13" LineBreakMode="WordWrap" />
                    <Button Text="Registrar CBZ, CBR y PDF" Clicked="OnRegisterFileAssociationsClicked" />
                    <Label Text="Conserva la aplicación en esta carpeta después del registro."
                           TextColor="{StaticResource TextMuted}" FontSize="11" LineBreakMode="WordWrap" />
                </VerticalStackLayout>
            </Border>

            <!-- Sección: Apariencia y lectura -->
            <Border x:Name="AppearancePanel" Style="{StaticResource SectionPanel}"
                    StrokeShape="RoundRectangle 20"
                    Padding="20">
                <VerticalStackLayout Spacing="16">
                    <Label Text="APARIENCIA Y LECTURA"
                           TextColor="{StaticResource NeonPurpleBright}"
                           FontFamily="OpenSansSemibold"
                           FontSize="12"
                           CharacterSpacing="1.4" />

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" MinimumHeightRequest="48">
                        <Label Text="Modo lectura nocturna (inversión suave)"
                               TextColor="{StaticResource TextPrimary}"
                               LineBreakMode="WordWrap"
                               VerticalOptions="Center" />
                        <Switch Grid.Column="1" IsToggled="{Binding NightReadingModeEnabled}"
                                SemanticProperties.Description="Modo lectura nocturna" />
                    </Grid>

                    <BoxView HeightRequest="1" BackgroundColor="{StaticResource SubtleBorder}" />

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" MinimumHeightRequest="48">
                        <Label Text="Filtro visual sepia"
                               TextColor="{StaticResource TextPrimary}"
                               LineBreakMode="WordWrap"
                               VerticalOptions="Center" />
                        <Switch Grid.Column="1" IsToggled="{Binding SepiaFilterEnabled}"
                                SemanticProperties.Description="Filtro visual sepia" />
                    </Grid>

                    <BoxView HeightRequest="1" BackgroundColor="{StaticResource SubtleBorder}" />

                    <Grid ColumnDefinitions="28,*,Auto" ColumnSpacing="12" MinimumHeightRequest="48">
                        <Image Grid.Column="0" Source="{Binding ReadingDirectionIcon}"
                               WidthRequest="24" HeightRequest="24"
                               Aspect="AspectFit" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="Lectura derecha a izquierda (Manga)"
                               TextColor="{StaticResource TextPrimary}"
                               LineBreakMode="WordWrap"
                               VerticalOptions="Center" />
                        <Switch Grid.Column="2" IsToggled="{Binding RightToLeftMangaMode}"
                                SemanticProperties.Description="Lectura derecha a izquierda, manga" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Sección: Disposición y ajuste -->
            <Border x:Name="LayoutPanel" Style="{StaticResource SectionPanel}"
                    StrokeShape="RoundRectangle 20"
                    Padding="20">
                <VerticalStackLayout Spacing="18">
                    <Label Text="DISPOSICIÓN Y AJUSTE"
                           TextColor="{StaticResource NeonPurpleBright}"
                           FontFamily="OpenSansSemibold"
                           FontSize="12"
                           CharacterSpacing="1.4" />

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Modo de vista"
                               TextColor="{StaticResource TextSecondary}"
                               FontSize="13" />
                        <Border BackgroundColor="{StaticResource Surface2}"
                                Stroke="{StaticResource SubtleBorder}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 14"
                                Padding="12,3">
                            <Grid ColumnDefinitions="28,*" ColumnSpacing="10">
                                <Image Source="{Binding LayoutModeIcon}"
                                       WidthRequest="24" HeightRequest="24"
                                       Aspect="AspectFit" VerticalOptions="Center" />
                                <Picker Grid.Column="1"
                                        ItemsSource="{Binding LayoutModeOptions}"
                                        SemanticProperties.Description="Modo de vista general"
                                        SelectedIndex="{Binding SelectedLayoutModeIndex}" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Ajuste de página"
                               TextColor="{StaticResource TextSecondary}"
                               FontSize="13" />
                        <Border BackgroundColor="{StaticResource Surface2}"
                                Stroke="{StaticResource SubtleBorder}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 14"
                                Padding="12,3">
                            <Picker ItemsSource="{Binding PageFitModeOptions}"
                                    SemanticProperties.Description="Ajuste de página general"
                                    SelectedIndex="{Binding SelectedPageFitModeIndex}" />
                        </Border>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Sección: Ventana -->
            <Border x:Name="WindowPanel" Style="{StaticResource SectionPanel}"
                    StrokeShape="RoundRectangle 20"
                    Padding="20">
                <VerticalStackLayout Spacing="16">
                    <Label Text="VENTANA"
                           TextColor="{StaticResource NeonPurpleBright}"
                           FontFamily="OpenSansSemibold"
                           FontSize="12"
                           CharacterSpacing="1.4" />

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" MinimumHeightRequest="48">
                        <Label Text="Pantalla completa"
                               TextColor="{StaticResource TextPrimary}"
                               LineBreakMode="WordWrap"
                               VerticalOptions="Center" />
                        <Switch Grid.Column="1" IsToggled="{Binding IsFullScreen}"
                                SemanticProperties.Description="Pantalla completa" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Border x:Name="OnlineTagsPanel" Style="{StaticResource SectionPanel}"
                    StrokeShape="RoundRectangle 20" Padding="20">
                <VerticalStackLayout Spacing="12">
                    <Label Text="FUENTES DE ETIQUETAS" TextColor="{StaticResource NeonPurpleBright}"
                           FontFamily="OpenSansSemibold" FontSize="12" CharacterSpacing="1.4" />
                    <Label Text="Idioma de las etiquetas" TextColor="{StaticResource TextSecondary}" FontSize="13" />
                    <Picker ItemsSource="{Binding TagLanguageOptions}" ItemDisplayBinding="{Binding Name, x:DataType=services:TagLanguageOption}"
                            SelectedItem="{Binding SelectedTagLanguage, Mode=TwoWay}"
                            SemanticProperties.Description="Idioma de las etiquetas" />
                    <Label Text="Se priorizan las etiquetas originales del idioma elegido y se traducen las restantes con MyMemory. Se revisan antes de guardar. La traducción necesita conexión y está sujeta al límite de uso del servicio. Cambiar el idioma no modifica automáticamente los documentos guardados."
                           TextColor="{StaticResource TextSecondary}" FontSize="13" LineBreakMode="WordWrap" />
                    <Label Text="Al descargar etiquetas, podrás revisar el resultado antes de guardarlo. Metron, Comic Vine y Google Books requieren una clave propia. Deja un campo vacío para quitar su clave."
                           TextColor="{StaticResource TextSecondary}" FontSize="13" LineBreakMode="WordWrap" />
                    <Label Text="Token de Metron" TextColor="{StaticResource TextSecondary}" FontSize="13" />
                    <Entry Text="{Binding MetronToken}" IsPassword="True" Placeholder="Token de Metron"
                           SemanticProperties.Description="Token de Metron" />
                    <Label Text="Clave de Comic Vine" TextColor="{StaticResource TextSecondary}" FontSize="13" />
                    <Entry Text="{Binding ComicVineApiKey}" IsPassword="True" Placeholder="Clave de Comic Vine"
                           SemanticProperties.Description="Clave de Comic Vine" />
                    <Label Text="Clave de Google Books" TextColor="{StaticResource TextSecondary}" FontSize="13" />
                    <Entry Text="{Binding GoogleBooksApiKey}" IsPassword="True" Placeholder="Clave de Google Books"
                           SemanticProperties.Description="Clave de Google Books" />
                    <Button Text="Guardar claves" Command="{Binding SaveOnlineKeysCommand}" HorizontalOptions="Start" />
                    <Label Text="Todas las fuentes sirven para cualquier formato. Open Library, AniList y Crossref no necesitan clave. Las fuentes con claves pendientes de configurar no aparecen al descargar etiquetas."
                           TextColor="{StaticResource TextMuted}" FontSize="12" LineBreakMode="WordWrap" />
                    <Label Text="{Binding OnlineKeysStatus}" TextColor="{StaticResource TextSecondary}"
                           FontSize="13" LineBreakMode="WordWrap" />
                </VerticalStackLayout>
            </Border>

            <Border x:Name="CachePanel" Style="{StaticResource SectionPanel}"
                    StrokeShape="RoundRectangle 20" Padding="20">
                <VerticalStackLayout Spacing="12">
                    <Label Text="CACHÉ"
                           TextColor="{StaticResource NeonPurpleBright}"
                           FontFamily="OpenSansSemibold" FontSize="12" CharacterSpacing="1.4" />
                    <Label Text="Libera las páginas en memoria y borra las miniaturas guardadas."
                           TextColor="{StaticResource TextSecondary}" FontSize="13" LineBreakMode="WordWrap" />
                    <Button Text="Borrar caché" Command="{Binding ClearCacheCommand}"
                            HorizontalOptions="Start"
                            SemanticProperties.Description="Borrar caché de páginas y portadas" />
                    <Label Text="{Binding CacheStatusMessage}"
                           TextColor="{StaticResource TextSecondary}" FontSize="13" LineBreakMode="WordWrap" />
                </VerticalStackLayout>
            </Border>

            <Border x:Name="ImportedFoldersPanel" Style="{StaticResource SectionPanel}"
                    StrokeShape="RoundRectangle 20" Padding="20">
                <VerticalStackLayout Spacing="12">
                    <Label Text="CARPETAS IMPORTADAS"
                           TextColor="{StaticResource NeonPurpleBright}"
                           FontFamily="OpenSansSemibold" FontSize="12" CharacterSpacing="1.4" />
                    <Label Text="Las carpetas escaneadas se guardan aquí para que puedas identificarlas después."
                           TextColor="{StaticResource TextSecondary}" FontSize="13" LineBreakMode="WordWrap" />
                    <Label Text="Todavía no has importado ninguna carpeta."
                           IsVisible="{Binding HasNoImportedFolders}"
                           TextColor="{StaticResource TextMuted}" FontSize="13" />
                    <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding ImportedFolders}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:ImportedFolderEntry">
                                <Border BackgroundColor="{StaticResource Surface2}"
                                        Stroke="{StaticResource SubtleBorder}"
                                        StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="12,8">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                            <Label Text="{Binding DisplayName}" FontAttributes="Bold"
                                                   TextColor="{StaticResource TextPrimary}" LineBreakMode="TailTruncation" />
                                            <Label Text="{Binding PathOrUri}" FontSize="11"
                                                   TextColor="{StaticResource TextSecondary}" LineBreakMode="MiddleTruncation" />
                                        </VerticalStackLayout>
                                        <Button Grid.Column="1" Text="Quitar"
                                                SemanticProperties.Description="Quitar carpeta y sus documentos de la biblioteca"
                                                Command="{Binding Source={x:Reference SettingsRootPage}, Path=ViewModel.RemoveImportedFolderCommand, x:DataType=views:SettingsPage}"
                                                CommandParameter="{Binding PathOrUri}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <Label Text="Quitar una carpeta retira sus documentos de la biblioteca, sin borrar los archivos originales."
                           TextColor="{StaticResource TextMuted}" FontSize="11" LineBreakMode="WordWrap" />
                    <Label Text="{Binding FolderStatusMessage}"
                           TextColor="{StaticResource TextSecondary}" FontSize="12" LineBreakMode="WordWrap" />
                </VerticalStackLayout>
            </Border>

            <Button Text="Volver"
                    Style="{StaticResource PrimaryNeonButton}"
                    Command="{Binding GoBackCommand}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
