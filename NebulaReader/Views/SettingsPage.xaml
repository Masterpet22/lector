<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:NebulaReader.ViewModels"
             x:Class="NebulaReader.Views.SettingsPage"
             x:DataType="vm:SettingsViewModel"
             BackgroundColor="{StaticResource BgCanvas}"
             Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Padding="20"
                             Spacing="16"
                             MaximumWidthRequest="720"
                             HorizontalOptions="Center">

            <!-- Sección: Apariencia y lectura -->
            <Border BackgroundColor="{StaticResource Surface1}"
                    Stroke="{StaticResource SubtleBorder}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 14"
                    Padding="16">
                <VerticalStackLayout Spacing="12">
                    <Label Text="APARIENCIA Y LECTURA"
                           TextColor="{StaticResource NeonPurpleBright}"
                           FontFamily="OpenSansSemibold"
                           FontSize="12"
                           CharacterSpacing="1.4" />

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <Label Text="Modo lectura nocturna (inversión suave)"
                               TextColor="{StaticResource TextPrimary}"
                               VerticalOptions="Center" />
                        <Switch Grid.Column="1" IsToggled="{Binding NightReadingModeEnabled}" />
                    </Grid>

                    <BoxView HeightRequest="1" BackgroundColor="{StaticResource SubtleBorder}" />

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <Label Text="Filtro visual sepia"
                               TextColor="{StaticResource TextPrimary}"
                               VerticalOptions="Center" />
                        <Switch Grid.Column="1" IsToggled="{Binding SepiaFilterEnabled}" />
                    </Grid>

                    <BoxView HeightRequest="1" BackgroundColor="{StaticResource SubtleBorder}" />

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <Label Text="Lectura derecha a izquierda (Manga)"
                               TextColor="{StaticResource TextPrimary}"
                               VerticalOptions="Center" />
                        <Switch Grid.Column="1" IsToggled="{Binding RightToLeftMangaMode}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Sección: Disposición y ajuste -->
            <Border BackgroundColor="{StaticResource Surface1}"
                    Stroke="{StaticResource SubtleBorder}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 14"
                    Padding="16">
                <VerticalStackLayout Spacing="14">
                    <Label Text="DISPOSICIÓN Y AJUSTE"
                           TextColor="{StaticResource NeonPurpleBright}"
                           FontFamily="OpenSansSemibold"
                           FontSize="12"
                           CharacterSpacing="1.4" />

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Modo de vista"
                               TextColor="{StaticResource TextSecondary}"
                               FontSize="13" />
                        <Border BackgroundColor="{StaticResource Surface2}"
                                Stroke="{StaticResource NeonPurpleDeep}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 10"
                                Padding="10,2">
                            <Picker ItemsSource="{Binding LayoutModeOptions}"
                                    SelectedIndex="{Binding SelectedLayoutModeIndex}" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Ajuste de página"
                               TextColor="{StaticResource TextSecondary}"
                               FontSize="13" />
                        <Border BackgroundColor="{StaticResource Surface2}"
                                Stroke="{StaticResource NeonPurpleDeep}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 10"
                                Padding="10,2">
                            <Picker ItemsSource="{Binding PageFitModeOptions}"
                                    SelectedIndex="{Binding SelectedPageFitModeIndex}" />
                        </Border>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Sección: Ventana -->
            <Border BackgroundColor="{StaticResource Surface1}"
                    Stroke="{StaticResource SubtleBorder}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 14"
                    Padding="16">
                <VerticalStackLayout Spacing="10">
                    <Label Text="VENTANA"
                           TextColor="{StaticResource NeonPurpleBright}"
                           FontFamily="OpenSansSemibold"
                           FontSize="12"
                           CharacterSpacing="1.4" />

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <Label Text="Pantalla completa"
                               TextColor="{StaticResource TextPrimary}"
                               VerticalOptions="Center" />
                        <Switch Grid.Column="1" IsToggled="{Binding IsFullScreen}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Button Text="Volver"
                    Style="{StaticResource PrimaryNeonButton}"
                    Command="{Binding GoBackCommand}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
